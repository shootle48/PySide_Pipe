# Pipe Inspector — optional environment overrides.
# Copy to `.env` and adjust per machine/station. All values are optional;
# anything unset falls back to config/settings.yaml, then to built-in defaults.

# ── Filesystem locations ─────────────────────────────────────────────
# Override the auto-detected project root (default: folder containing pyproject.toml).
# PIPE_INSPECTOR_ROOT=/opt/pipe-inspector
# PIPE_INSPECTOR_DATA_DIR=/data
# PIPE_INSPECTOR_LOGS_DIR=/var/log/pipe-inspector
# PIPE_INSPECTOR_EXPORTS_DIR=/data/exports
# PIPE_INSPECTOR_DB_PATH=/data/pipe_inspector.db

# ── Runtime overrides (take precedence over config/settings.yaml) ─────
# PIPE_INSPECTOR_CAMERA_INDEX=2
# PIPE_INSPECTOR_TRIGGER_MODE=manual          # manual | timer | gpio
# PIPE_INSPECTOR_RS485_MODE=off               # off | mock | real
